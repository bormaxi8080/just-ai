# ===================================================================
# just-ai Development Container
# ===================================================================
FROM rust:1.89-bookworm

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    ca-certificates \
    just \
    git \
    curl \
    build-essential \
    libwebkit2gtk-4.1-dev \
    libgtk-4-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    nodejs \
    npm \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -u 1000 -s /bin/bash justai

# Install cargo tools
RUN cargo install cargo-watch cargo-expand cargo-audit cargo-outdated cargo-deny

# Switch to non-root user
USER justai
WORKDIR /workspace

# Environment
ENV CARGO_HOME=/usr/local/cargo
ENV PATH="/usr/local/cargo/bin:${PATH}"

# Default command
CMD ["sleep", "infinity"]