FROM node:22-bookworm-slim AS frontend-builder
WORKDIR /app
COPY apps/just-ai-gui/package.json apps/just-ai-gui/package-lock.json ./
RUN npm ci
COPY apps/just-ai-gui/src/ src/
COPY apps/just-ai-gui/index.html apps/just-ai-gui/vite.config.ts apps/just-ai-gui/tsconfig.json ./
RUN npm run build

FROM rust:1.89-slim-bookworm AS builder
RUN apt-get update && apt-get install -y --no-install-recommends pkg-config libssl-dev ca-certificates libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev librsvg2-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV CARGO_TARGET_DIR=/app/target
ENV CARGO_BUILD_JOBS=2
COPY Cargo.toml Cargo.lock build.rs ./
COPY src/ src/
COPY etc/ etc/
COPY completions/ completions/
COPY CHANGELOG.md ./
COPY crates/ crates/
COPY apps/just-ai-mcp/ apps/just-ai-mcp/
COPY agent/ agent/
COPY docs/ docs/
COPY apps/just-ai-gui/src-tauri/ apps/just-ai-gui/src-tauri/
COPY --from=frontend-builder /app/dist/ apps/just-ai-gui/dist/
RUN cargo build --release --locked -p just
RUN cargo build --release --locked --manifest-path apps/just-ai-gui/src-tauri/Cargo.toml --bin just-ai-gui --features tauri/custom-protocol

FROM builder AS webdriver-builder
RUN cargo install tauri-driver --version 2.0.6 --locked --root /usr/local

FROM debian:bookworm-slim AS desktop-runtime
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libssl3 libwebkit2gtk-4.1-0 libgtk-3-0 libayatana-appindicator3-1 librsvg2-2 && rm -rf /var/lib/apt/lists/*
RUN useradd -m -u 1000 -s /bin/bash justai
COPY --from=builder /app/target/release/just /usr/local/bin/just
COPY --from=builder /app/target/release/just-ai-gui /usr/local/bin/just-ai-gui
RUN mkdir -p /home/justai/.local/share/just-ai && chown -R justai:justai /home/justai/.local
USER justai
WORKDIR /workspace
ENV JUST_AI_DATA_DIR=/home/justai/.local/share/just-ai
ENTRYPOINT ["just-ai-gui"]

# Explicit opt-in test image; the default final stage remains the desktop runtime.
FROM desktop-runtime AS native-smoke
USER root
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-selenium xvfb xauth webkit2gtk-driver && rm -rf /var/lib/apt/lists/*
COPY --from=webdriver-builder /usr/local/bin/tauri-driver /usr/local/bin/tauri-driver
COPY tests/desktop_smoke.py /opt/desktop_smoke.py
RUN mkdir -p /workspace /artifacts && chown justai:justai /workspace /artifacts
USER justai
ENTRYPOINT ["xvfb-run", "-a", "python3", "/opt/desktop_smoke.py", "--application", "/usr/local/bin/just-ai-gui", "--just", "/usr/local/bin/just", "--artifacts", "/artifacts"]

FROM desktop-runtime AS runtime
